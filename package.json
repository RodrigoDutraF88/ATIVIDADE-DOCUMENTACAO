{
  "name": "atividade-documentacao-api",
  "version": "1.0.0",
  "description": "Agenda em NestJS, atividade da Trilha de Documentação de API da CJR",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "docs:export": "nest build && node scripts/export-openapi.mjs",
    "docs:lint": "spectral lint openapi.json --fail-severity=warn"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/mapped-types": "2.1.1",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@stoplight/spectral-cli": "6.16.3",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
